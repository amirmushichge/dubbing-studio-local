# Optional separate location for projects and source videos.
# DUBBING_STUDIO_DATA=F:\DubbingStudioData

# Optional separate location for models (defaults to .\runtime).
# DUBBING_STUDIO_RUNTIME=F:\DubbingStudioRuntime

# Compute profile: cuda, apple_silicon or cpu. Normally detected automatically.
# DUBBING_STUDIO_BACKEND=apple_silicon

# Optional explicit Hy-MT2 model directory.
# DUBBING_STUDIO_TRANSLATION_MODEL=/Volumes/Models/Hy-MT2-7B

# Maximum upload size in bytes (defaults to 12 GB).
# DUBBING_STUDIO_MAX_UPLOAD=12884901888

# UI smoke-test mode without AI models.
# DUBBING_STUDIO_MOCK=1
