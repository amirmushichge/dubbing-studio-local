# Необязательное отдельное место для проектов и исходных видео.
# DUBBING_STUDIO_DATA=F:\DubbingStudioData

# Необязательное отдельное место для моделей (по умолчанию .\runtime).
# DUBBING_STUDIO_RUNTIME=F:\DubbingStudioRuntime

# Максимальный размер загрузки, байт (по умолчанию 12 ГБ).
# DUBBING_STUDIO_MAX_UPLOAD=12884901888

# Только для быстрой проверки интерфейса без AI-моделей.
# DUBBING_STUDIO_MOCK=1
